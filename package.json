{
  "name": "tuition-desk",
  "version": "1.0.0",
  "private": true,
  "description": "Personal tuition management and teaching-time tracker: students, schedules, classes, teaching hours, payments and backups.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check:repo": "node scripts/check-repo.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run lint && npm test && npm run check:repo && npm run build && npm run smoke"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
