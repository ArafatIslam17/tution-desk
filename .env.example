# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API (or "Connect" -> App frameworks).
# The anon/publishable key is safe to ship to the browser: row-level security in
# supabase/schema.sql is what protects your data. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
